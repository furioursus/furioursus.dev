{
	"name": "furioursus-dev",
	"type": "module",
	"version": "8.2.0",
	"private": false,
	"scripts": {
		"postinstall": "SHARP_IGNORE_GLOBAL_LIBVIPS=1 npm rebuild sharp --force",
		"predev": "node scripts/sanitize-dates.mjs",
		"dev": "trap 'kill 0' EXIT; node scripts/sanitize-dates.mjs --watch & astro dev",
		"dev:remote": "node scripts/dev-remote.mjs",
		"start": "astro dev",
		"prebuild": "node scripts/sanitize-dates.mjs",
		"build": "astro build",
		"postbuild": "pagefind --site dist",
		"preview": "astro preview",
		"check": "astro check && biome check",
		"lint": "biome check --write",
		"format": "prettier -w . --cache",
		"generate:cover-alt": "node scripts/generate-cover-alt.mjs",
		"paper:average": "node scripts/paper-average.mjs",
		"sanitize:dates": "node scripts/sanitize-dates.mjs",
		"sanitize:watch": "node scripts/sanitize-dates.mjs --watch",
		"syndicate:preview": "node scripts/syndicate-preview.mjs"
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "^0.4.7",
		"@astrojs/mdx": "8.1.3",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.4",
		"@astrojs/vue": "7.1.2",
		"@furioursus/ui": "github:furioursus/furioursus-ui#v0.3.0",
		"@pagefind/component-ui": "^1.6.0",
		"@tailwindcss/vite": "4.3.5",
		"animate.css": "^4.1.1",
		"astro": "7.4.7",
		"astro-discogs-collection": "github:furioursus/astro-discogs-collection",
		"astro-expressive-code": "^0.44.3",
		"astro-icon": "^1.1.5",
		"astro-mtg-collection": "github:furioursus/astro-mtg-collection",
		"astro-robots-txt": "^1.0.0",
		"astro-webmanifest": "^1.0.0",
		"hastscript": "^9.0.3",
		"mdast-util-directive": "^3.2.0",
		"mdast-util-to-markdown": "^2.1.2",
		"mdast-util-to-string": "^4.0.0",
		"prop-for-that": "^0.7.12",
		"satori": "0.63.2",
		"satori-html": "^0.3.2",
		"satteri": "^0.11.7",
		"sharp": "^0.35.4",
		"tailwindcss": "^4.3.3",
		"vue": "^3.5.45"
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "^0.125.0",
		"@astrojs/check": "^0.9.12",
		"@biomejs/biome": "^2.6.6",
		"@iconify-json/mdi": "^1.2.2",
		"@pagefind/default-ui": "^1.6.0",
		"@tailwindcss/typography": "^0.5.20",
		"@types/hast": "^3.0.4",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.6.6",
		"mdast-util-to-hast": "^13.2.1",
		"pagefind": "^1.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "1.1.2",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"qrcode-terminal": "^0.12.0",
		"reading-time": "^1.5.0",
		"typescript": "^6.0.3"
	},
	"overrides": {
		"sharp": "^0.35.4"
	}
}
