				function setRandomGreeting() {
					const hello = document.getElementById("greeting-text");
					if (!hello) return;

					const currentLangcode = hello.getAttribute("lang");
					const choices = greetings.filter((g) => g.langcode !== currentLangcode);
					const randHello = choices[Math.floor(Math.random() * choices.length)];

					hello.setAttribute("lang", randHello.langcode);
					hello.setAttribute("dir", randHello.dir);
					hello.textContent = randHello.text;

					// restart the rubberBand animation (from animate.css) even if it's already running
					hello.style.animation = "none";
					const reflow = hello.offsetHeight;
					hello.style.animation = "rubberBand 500ms";
				}

				setRandomGreeting();

				const greetingEl = document.getElementById("greeting");
				greetingEl?.addEventListener("click", setRandomGreeting);
