---
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { menuLinks, siteConfig } from "@/site.config";
---

<header class="group breakout-container mb-6" id="main-header">
	<div class="relative mx-auto max-w-3xl px-4 py-8 sm:px-8">
		{
			/* ps-18 lives on this innermost row specifically, not the px-4/sm:px-8 wrapper
			above — Tailwind's ps-* replaces (not adds to) px-*'s start-side value, so
			stacking both on one element would make the logo's -inset-s-18 pull-back cancel
			against the wrong edge (the raw breakout edge instead of the content column's
			edge), landing it 32px too far left of the h1 below. Mirrors this file's
			pre-sticky-header structure, where ps-18 sat on <header> itself while px-4/sm:px-8
			lived one level up on Base.astro's wrapper — same two-level relationship, just
			both levels now live inside the breakout shell instead of one being Base.astro's. */
		}
		<div class:list={["flex items-center", siteConfig.showLogo && "sm:relative sm:ps-18"]}>
			<div class="flex sm:flex-col sm:items-start">
				<a
					aria-current={Astro.url.pathname === "/" ? "page" : false}
					class="group inline-flex items-center sm:inline-block"
					href="/"
				>
					{
						/* grayscale/hover-color lives on the logo and title individually
						(via group-hover, scoped to this <a>) instead of on <a> itself — a
						CSS filter on an element makes it a containing block for absolutely
						positioned descendants regardless of its own `position`, which broke
						the logo's vertical centering below (it was centering against <a>'s
						own ~32px title-text height instead of the full row height). */
					}
					{
						/* The logo bleeds left into the ps-18 gutter reserved on the row above,
						sized bigger than that gutter on purpose so it reads as a prominent mark
						rather than a small icon — sizing it via height with an auto width (to
						keep the artwork's own aspect ratio, not the odd one a fixed w-* would
						force) means its rendered width isn't a static number to subtract by
						hand. `inset-s-18` + `-translate-x-[calc(100%+0.5rem)]` sidesteps that:
						positioned at the gutter's *far* edge (start + ps-18, i.e. flush with the
						title text's own start) then shifted left by its own width *plus* a fixed
						0.5rem via `translate`, landing its right edge a consistent half-rem
						before the title regardless of what the width actually resolves to —
						stays correct if the height (and so the auto width) ever changes again.
						h-18 specifically (not just "smaller") is chosen to leave clear space
						above and below within this row's own height (136px at sm: 72px logo +
						2×32px from py-8 on the row above). Vertical centering
						(inset-y-0 + my-auto) is a separate,
						unrelated mechanism — see the containing-block note above for why that
						one specifically needed <a> to stop being a filtered element. */
					}
					{
						siteConfig.showLogo && (
							<svg
								data-name="Bear Face"
								aria-hidden="true"
								class="logo-mark me-4 h-10 w-6 sm:absolute sm:inset-y-0 sm:inset-s-18 sm:my-auto sm:me-0 sm:h-18 sm:w-auto sm:-translate-x-[calc(100%+0.5rem)] sm:grayscale sm:group-hover:filter-none"
								fill="currentColor"
								focusable="false"
								viewBox="0 0 68.31 64.71"
								xmlns="http://www.w3.org/2000/svg"
							>
								{/* feTurbulence + feDisplacementMap — a photocopy-static edge distortion,
									referenced as `url(#logo-melt)` from logo.css, applied there to #Head +
									#BackEar1 + #BackEar2 only (the body silhouette and the two solid-dark
									outer-ear shapes), not the pale ear-interior cutouts
									(#FrontEar1/#FrontEar2) or the eyes/muzzle — see docs/logo.md for which
									paths and why. Defined here rather than as a separate hidden <svg>
									elsewhere in the page since `url(#id)` filter references resolve against
									the whole document either way — keeping it inline with the artwork it's
									for is just easier to find.
									This distortion already rotates/scales rigidly along with #Head's
									`logo-breathe`/#Ear1/#Ear2's twitch CSS animations for free — SVG filter
									primitives with `primitiveUnits="userSpaceOnUse"` (the default, unset here)
									resolve against the *current* user-space coordinate system, which already
									includes whatever CSS `transform` is live on the filtered element, so the
									noise moves with the shape without this needing anything extra. The
									`<animate>` below is a separate, additional effect on top of that: the
									distortion's own *intensity* pulsing over time, synced to logo-breathe's
									same 5s duration so it's stronger right as the head visibly swells and
									weaker as it settles — the melt visibly breathing along with the shape,
									not just a static fuzzy edge that happens to ride along rigidly. */}
								<defs>
									<filter height="160%" id="logo-melt" width="160%" x="-30%" y="-30%">
										<feTurbulence
											type="fractalNoise"
											baseFrequency="0.5"
											numOctaves="10"
											result="noise"
										/>
										<feDisplacementMap in="SourceGraphic" in2="noise" scale="3">
											{
												/* id="logo-melt-pulse": the one bit of decorative motion on this
												mark that isn't plain CSS — feTurbulence/feDisplacementMap
												attributes aren't real CSS properties (no `var()`/`@property`
												support), so SMIL's `<animate>` is the only declarative way to
												animate them at all. Unlike every CSS `animation` in logo.css,
												SMIL doesn't honor `prefers-reduced-motion` on its own — see the
												small inline script right after this SVG for the one-time check
												that removes this element entirely for readers with that
												preference set, before it ever plays a single frame. */
											}
											<animate
												attributeName="scale"
												dur="5s"
												id="logo-melt-pulse"
												repeatCount="indefinite"
												values="1;6;1"
											/>
										</feDisplacementMap>
									</filter>
								</defs>
								<g id="Ear2Track">
									<g id="Ear2">
										<path
											id="BackEar2"
											class="text-global-text"
											d="M64.56,5.14c-.1-3.39-5.74-6.03-9.29-4.72-2.48,1.36-2.7,2.44-3.27,7.07-1.64,13.45,12.62,8.14,12.55-2.35Z"
										/>
										<path
											id="FrontEar2"
											class="text-global-bg"
											d="M57.51,3.9c2.03,1.35,2.61,4.95,2.08,7.19-.12.47-.46.66-.89.32-1.09-.96-2.64-1.65-3.86-2.48-.2-.16-.45-.35-.48-.61.13-1.52.99-4.94,3.02-4.49l.13.06Z"
										/>
									</g>
								</g>
								<g id="Ear1Track">
									<g id="Ear1">
										<path
											id="BackEar1"
											class="text-global-text"
											d="M12.94,10.49c-.76-3.47-1.62-6.76-5.98-6.62-8.89.28-8.92,8.9-1.75,14.99,4.58,3.9,9.43-1.14,7.74-8.37Z"
										/>
										<path
											id="FrontEar1"
											class="text-global-bg"
											d="M5.16,16.15c-.89-.6-1.06-3.39-1.12-4.72.03-1.8.08-4.72,2.62-4.37,1.17.15,2.34.68,2.86,1.74.44,1.03.83,2.28.18,3.23-.72,1.04-1.72,1.66-2.62,2.57-.69.62-1.41,1.53-1.84,1.56h-.09Z"
										/>
									</g>
								</g>
								<path
									id="Head"
									class="text-global-text"
									d="M50.84,7.62C33.33-1.02,1.71,9.36.07,30.87c-1.58,25.42,23,40.31,45.97,31.1,25.73-9.37,31.45-41.71,4.98-54.26l-.18-.08Z"
								/>
								<g id="MuzzleTrack">
									<path
										id="Muzzle"
										class="text-global-bg"
										d="M43.41,27.44c-.52,1.18-2.1,1.97-3.54,2.2-.39.08-.9.13-1.19.43-.18.18-.26.46-.27.78.15,2.62.46,5.12.76,7.54.37,2.8.78,5.67,1.31,8.59.12.71.33,1.67.21,2.38-.33.99-1.1-.35-1.16-.89-1.08-5.63-1.74-11.64-2.27-17.32-.03-.26-.07-.51-.15-.73-.22-.84-1.33-.83-2.05-1.09-.57-.21-1.21-.68-1.73-1.1-6.47-5.37,11.04-8.14,10.15-.96l-.06.16Z"
									/>
								</g>
								<g id="Eyes">
									<g id="Eye2Track">
										<path
											id="Eye2"
											class="text-global-bg"
											d="M50.74,25c-1.88,1.31-2.23-2.95-1.92-3.96.7-2.35,1.57-2.02,2.13-.84.57,1.38.92,3.51-.12,4.72l-.09.08Z"
										/>
									</g>
									<g id="Eye1Track">
										<path
											id="Eye1"
											class="cls-1 text-global-bg"
											d="M24.07,28.36c-2.44.8-1.99-4.3-1.35-5.16,2.52-2.22,2.66,4.19,1.45,5.11l-.09.05Z"
										/>
									</g>
								</g>
							</svg>
						)
					}
					{
						siteConfig.showLogo && (
							<script is:inline>
								// SMIL <animate> (id="logo-melt-pulse", inside the #logo-melt filter above)
								// doesn't honor prefers-reduced-motion on its own — CSS's `@media
								// (prefers-reduced-motion: reduce)`, which every other idle-loop in logo.css
								// relies on, has no SMIL equivalent. is:inline (not the module script further
								// below) specifically so this runs synchronously during parsing, before the
								// animation has a chance to render even one frame — same reasoning as
								// ThemeProvider.astro's own is:inline script avoiding a flash of the wrong
								// theme. Removing the element entirely (rather than pausing it) lets
								// #logo-melt fall back to feDisplacementMap's own static `scale="3"` — the
								// same resting frame the pulse animates around, so this reads as "no pulse",
								// not "frozen mid-pulse" or "no distortion at all".
								// One-time check, not a live matchMedia listener — doesn't handle the
								// preference changing *while the page is open*, an acceptable gap for a
								// decorative pulse matching other documented trade-offs in this file (see
								// pointer-idle's own note in docs/logo.md).
								if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
									document.getElementById("logo-melt-pulse")?.remove();
								}
							</script>
						)
					}
					<span
						class="text-accent-2 text-xl font-bold sm:text-2xl sm:grayscale sm:group-hover:filter-none"
					>
						{siteConfig.title}
					</span>
				</a>
				{
					// max-sm: (Tailwind's max-width variant — compiles to the same `@media (width < 40rem)`
					// range query this used to be hand-written as) — the desktop nav is always-visible
					// (sm:flex, unconditional, above) so none of this display-toggling/animation applies there.
					// group-[.menu-open]: reads the .menu-open class MobileNavBtn's script toggles on
					// <header> (already used for z-50 above) — no :global()-equivalent needed since
					// Tailwind utilities aren't scoped to begin with.
					// top-18 (4.5rem): a plain, hardcoded offset, not measured — <header> is static now
					// (never sticky, never resizes on scroll), so this row's own rendered height is a
					// fixed, known quantity, the same way Astro Cactus upstream hardcodes its own
					// equivalent (`top-12`) rather than measuring it. No JS, no ResizeObserver, no
					// custom property to keep in sync with anything.
					// transform/transition are arbitrary properties, not scale-*/translate-*/duration-*
					// utilities — Tailwind v4's scale-*/translate-* utilities set the standalone `scale`/
					// `translate` CSS properties, not `transform`, so a hand-written `transition: transform
					// ...` list needs the matching arbitrary `[transform:...]` to actually be listing the
					// property that's changing. [@starting-style]: is Tailwind's arbitrary at-rule variant
					// (rather than the dedicated `starting:` shorthand) so this doesn't depend on exactly
					// which Tailwind 4.x minor version added that shorthand.
					// divide-muted: explicit, not incidental — `divide-x`/`divide-y` add their border with
					// no color utility alongside them, and border-color's own CSS default is `currentColor`,
					// so each link's own divider (Tailwind puts it on the *preceding* link, as a
					// border-inline-end, not on the following one as a border-start) would otherwise pick
					// up that same link's `color` — meaning the separator visibly flashed the hover/active
					// yellow right along with whichever link was being hovered. Pinning it to --color-muted
					// decouples the divider from any one link's interaction state.
				}
				<nav
					aria-label="Main"
					class="bg-global-bg divide-muted absolute -inset-x-4 top-18 flex-col divide-y px-2 py-4 group-[.menu-open]:z-50 motion-reduce:transition-none max-sm:hidden max-sm:transform-[scale(0.92)_translateY(-0.5rem)] max-sm:opacity-0 max-sm:[transition:opacity_0.15s_ease-in,transform_0.15s_ease-in,display_0.15s_allow-discrete] group-[.menu-open]:max-sm:flex group-[.menu-open]:max-sm:transform-[scale(1)_translateY(0)] group-[.menu-open]:max-sm:opacity-100 group-[.menu-open]:max-sm:[transition:opacity_0.3s_cubic-bezier(0.34,1.56,0.64,1),transform_0.3s_cubic-bezier(0.34,1.56,0.64,1),display_0.3s_allow-discrete] sm:static sm:z-auto sm:-ms-4 sm:mt-1 sm:flex sm:flex-row sm:divide-x sm:divide-y-0 sm:bg-transparent sm:p-0 group-[.menu-open]:max-sm:starting:transform-[scale(0.92)_translateY(-0.5rem)] group-[.menu-open]:max-sm:starting:opacity-0"
					id="navigation-menu"
				>
					{
						// "/" is excluded: the logo link right before this nav already goes home, so a
						// "Home" item here would be an adjacent link to the same page (WAVE flags this).
						// The footer's copy of menuLinks keeps "Home" — it has no adjacent logo link.
						// hover:text-nav-hover + active:text-nav-hover: --color-nav-hover (global.css)
						// is a no-op in light mode (same value as --color-accent, so this class pair
						// changes nothing there) and swaps to a vivid yellow in dark mode — a third,
						// distinct interaction color rather than a tint of the pink base, so the nav
						// state changes color instead of just gaining an underline like it did before.
						menuLinks
							.filter((link) => link.path !== "/")
							.map((link) => (
								<a
									aria-current={Astro.url.pathname === link.path ? "page" : false}
									class="text-accent hover:text-nav-hover active:text-nav-hover px-4 py-4 font-semibold sm:py-0 sm:underline-offset-2 sm:hover:underline"
									href={link.path}
								>
									{link.title}
								</a>
							))
					}
				</nav>
			</div>
			<Search />
			<ThemeToggle />
			<mobile-button>
				<button
					aria-expanded="false"
					aria-haspopup="menu"
					class="group relative ms-4 h-7 w-7 sm:invisible sm:hidden"
					id="toggle-navigation-menu"
					type="button"
				>
					<span class="sr-only">Open main menu</span>
					<svg
						aria-hidden="true"
						class="absolute inset-s-1/2 top-1/2 h-full w-full -translate-x-1/2 -translate-y-1/2 transition-all group-aria-expanded:scale-0 group-aria-expanded:opacity-0"
						fill="none"
						focusable="false"
						stroke="currentColor"
						stroke-width="1.5"
						viewBox="0 0 24 24"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path d="M3.75 9h16.5m-16.5 6.75h16.5" stroke-linecap="round" stroke-linejoin="round"
						></path>
					</svg>
					<svg
						aria-hidden="true"
						class="text-accent absolute inset-s-1/2 top-1/2 h-full w-full -translate-x-1/2 -translate-y-1/2 scale-0 opacity-0 transition-all group-aria-expanded:scale-100 group-aria-expanded:opacity-100"
						fill="none"
						focusable="false"
						stroke="currentColor"
						stroke-width="1.5"
						viewBox="0 0 24 24"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</button>
			</mobile-button>
		</div>
	</div>
</header>

<script>
	import { toggleClass } from "@/utils/domElement";

	class MobileNavBtn extends HTMLElement {
		#menuOpen: boolean = false;

		connectedCallback() {
			const headerEl = document.getElementById("main-header");
			const mobileButtonEl = this.querySelector<HTMLButtonElement>("button");

			mobileButtonEl?.addEventListener("click", () => {
				if (headerEl) toggleClass(headerEl, "menu-open");
				this.#menuOpen = !this.#menuOpen;
				mobileButtonEl.setAttribute("aria-expanded", this.#menuOpen.toString());
			});
		}
	}

	customElements.define("mobile-button", MobileNavBtn);
</script>
