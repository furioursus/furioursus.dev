---
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { menuLinks, siteConfig } from "@/site.config";
---

<header class="group breakout-container mb-6" id="main-header">
	<div class="relative mx-auto max-w-3xl px-4 py-8 sm:px-8">
		{/* FOOTGUN: ps-18 belongs on this row, not the px-4/sm:px-8 wrapper — Tailwind's ps-* replaces
			px-*'s start value rather than adding to it. See docs/navigation.md. */}
		<div class:list={["flex items-center", siteConfig.showLogo && "sm:relative sm:ps-18"]}>
			<div class="flex sm:flex-col sm:items-start">
				<a
					aria-current={Astro.url.pathname === "/" ? "page" : false}
					class="group inline-flex items-center sm:inline-block"
					href="/"
				>
					{/* FOOTGUN: grayscale stays on the logo/title, not this <a> — a CSS `filter` makes an
						element a containing block for abspos descendants, which breaks the logo's vertical
						centering. Logo sizing and the -translate-x pull-back: docs/navigation.md. */}
					{siteConfig.showLogo && (
						<svg
							data-name="Bear Face"
							aria-hidden="true"
							class="logo-mark me-4 h-10 w-6 sm:absolute sm:inset-y-0 sm:inset-s-18 sm:my-auto sm:me-0 sm:h-18 sm:w-auto sm:-translate-x-[calc(100%+0.5rem)] sm:grayscale sm:group-hover:filter-none"
							fill="currentColor"
							focusable="false"
							viewBox="0 0 68.31 64.71"
							xmlns="http://www.w3.org/2000/svg"
						>
							{/* Photocopy-static edge distortion, referenced as url(#logo-melt) from logo.css.
								Inline here rather than in a hidden <svg> just to sit with the artwork it
								distorts; url(#id) resolves document-wide either way. See docs/logo.md. */}
							<defs>
								<filter height="160%" id="logo-melt" width="160%" x="-30%" y="-30%">
									<feTurbulence
										type="fractalNoise"
										baseFrequency="0.5"
										numOctaves="10"
										result="noise"
									/>
									<feDisplacementMap in="SourceGraphic" in2="noise" scale="3">
										<animate
											attributeName="scale"
											dur="5s"
											id="logo-melt-pulse"
											repeatCount="indefinite"
											values="1;6;1"
										/>
									</feDisplacementMap>
								</filter>
							</defs>
							<g id="Ear2Track">
								<g id="Ear2">
									<path
										id="BackEar2"
										class="text-global-text"
										d="M64.56,5.14c-.1-3.39-5.74-6.03-9.29-4.72-2.48,1.36-2.7,2.44-3.27,7.07-1.64,13.45,12.62,8.14,12.55-2.35Z"
									/>
									<path
										id="FrontEar2"
										class="text-global-bg"
										d="M57.51,3.9c2.03,1.35,2.61,4.95,2.08,7.19-.12.47-.46.66-.89.32-1.09-.96-2.64-1.65-3.86-2.48-.2-.16-.45-.35-.48-.61.13-1.52.99-4.94,3.02-4.49l.13.06Z"
									/>
								</g>
							</g>
							<g id="Ear1Track">
								<g id="Ear1">
									<path
										id="BackEar1"
										class="text-global-text"
										d="M12.94,10.49c-.76-3.47-1.62-6.76-5.98-6.62-8.89.28-8.92,8.9-1.75,14.99,4.58,3.9,9.43-1.14,7.74-8.37Z"
									/>
									<path
										id="FrontEar1"
										class="text-global-bg"
										d="M5.16,16.15c-.89-.6-1.06-3.39-1.12-4.72.03-1.8.08-4.72,2.62-4.37,1.17.15,2.34.68,2.86,1.74.44,1.03.83,2.28.18,3.23-.72,1.04-1.72,1.66-2.62,2.57-.69.62-1.41,1.53-1.84,1.56h-.09Z"
									/>
								</g>
							</g>
							<path
								id="Head"
								class="text-global-text"
								d="M50.84,7.62C33.33-1.02,1.71,9.36.07,30.87c-1.58,25.42,23,40.31,45.97,31.1,25.73-9.37,31.45-41.71,4.98-54.26l-.18-.08Z"
							/>
							<g id="MuzzleTrack">
								<path
									id="Muzzle"
									class="text-global-bg"
									d="M43.41,27.44c-.52,1.18-2.1,1.97-3.54,2.2-.39.08-.9.13-1.19.43-.18.18-.26.46-.27.78.15,2.62.46,5.12.76,7.54.37,2.8.78,5.67,1.31,8.59.12.71.33,1.67.21,2.38-.33.99-1.1-.35-1.16-.89-1.08-5.63-1.74-11.64-2.27-17.32-.03-.26-.07-.51-.15-.73-.22-.84-1.33-.83-2.05-1.09-.57-.21-1.21-.68-1.73-1.1-6.47-5.37,11.04-8.14,10.15-.96l-.06.16Z"
								/>
							</g>
							<g id="Eyes">
								<g id="Eye2Track">
									<path
										id="Eye2"
										class="text-global-bg"
										d="M50.74,25c-1.88,1.31-2.23-2.95-1.92-3.96.7-2.35,1.57-2.02,2.13-.84.57,1.38.92,3.51-.12,4.72l-.09.08Z"
									/>
								</g>
								<g id="Eye1Track">
									<path
										id="Eye1"
										class="cls-1 text-global-bg"
										d="M24.07,28.36c-2.44.8-1.99-4.3-1.35-5.16,2.52-2.22,2.66,4.19,1.45,5.11l-.09.05Z"
									/>
								</g>
							</g>
						</svg>
					)}
					{siteConfig.showLogo && <script is:inline>
						// SMIL ignores prefers-reduced-motion, so the pulse has to be removed by hand.
						// FOOTGUN: is:inline, not a module script — it must run during parsing, before the
						// animation paints a frame. Removing (not pausing) falls back to scale="3", the
						// pulse's own resting value. See docs/logo.md.
						if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
							document.getElementById("logo-melt-pulse")?.remove();
						}
					</script>}
					<span class="text-accent-2 text-xl font-bold sm:text-2xl sm:grayscale sm:group-hover:filter-none">
						{siteConfig.title}
					</span>
				</a>
				{
					// FOOTGUN: transform/transition are arbitrary properties on purpose — Tailwind v4's
					// scale-*/translate-* set the standalone `scale`/`translate` properties, not
					// `transform`, so a hand-written `transition: transform` would list nothing that
					// changes. FOOTGUN: divide-muted is required — divide-* falls back to currentColor,
					// so the separator would flash each link's hover color. See docs/navigation.md.
				}
				<nav
					aria-label="Main"
					class="bg-global-bg divide-muted absolute -inset-x-4 top-18 flex-col divide-y px-2 py-4 group-[.menu-open]:z-50 motion-reduce:transition-none max-sm:hidden max-sm:transform-[scale(0.92)_translateY(-0.5rem)] max-sm:opacity-0 max-sm:[transition:opacity_0.15s_ease-in,transform_0.15s_ease-in,display_0.15s_allow-discrete] group-[.menu-open]:max-sm:flex group-[.menu-open]:max-sm:transform-[scale(1)_translateY(0)] group-[.menu-open]:max-sm:opacity-100 group-[.menu-open]:max-sm:[transition:opacity_0.3s_cubic-bezier(0.34,1.56,0.64,1),transform_0.3s_cubic-bezier(0.34,1.56,0.64,1),display_0.3s_allow-discrete] sm:static sm:z-auto sm:-ms-4 sm:mt-1 sm:flex sm:flex-row sm:divide-x sm:divide-y-0 sm:bg-transparent sm:p-0 group-[.menu-open]:max-sm:starting:transform-[scale(0.92)_translateY(-0.5rem)] group-[.menu-open]:max-sm:starting:opacity-0"
					id="navigation-menu"
				>
					{
						// "/" is excluded: the logo link just before this nav is already an adjacent link
						// to the same page, which WAVE flags. The footer's copy keeps "Home".
						menuLinks
							.filter((link) => link.path !== "/")
							.map((link) => (
								<a
									aria-current={Astro.url.pathname === link.path ? "page" : false}
									class="text-accent hover:text-nav-hover active:text-nav-hover px-4 py-4 font-semibold sm:py-0 sm:underline-offset-2 sm:hover:underline"
									href={link.path}
								>
									{link.title}
								</a>
							))
					}
				</nav>
			</div>
			<Search />
			<ThemeToggle />
			<mobile-button>
				<button
					aria-expanded="false"
					aria-haspopup="menu"
					class="group relative ms-4 h-7 w-7 sm:invisible sm:hidden"
					id="toggle-navigation-menu"
					type="button"
				>
					<span class="sr-only">Open main menu</span>
					<svg
						aria-hidden="true"
						class="absolute inset-s-1/2 top-1/2 h-full w-full -translate-x-1/2 -translate-y-1/2 transition-all group-aria-expanded:scale-0 group-aria-expanded:opacity-0"
						fill="none"
						focusable="false"
						stroke="currentColor"
						stroke-width="1.5"
						viewBox="0 0 24 24"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path
							d="M3.75 9h16.5m-16.5 6.75h16.5"
							stroke-linecap="round"
							stroke-linejoin="round"
						></path>
					</svg>
					<svg
						aria-hidden="true"
						class="text-accent absolute inset-s-1/2 top-1/2 h-full w-full -translate-x-1/2 -translate-y-1/2 scale-0 opacity-0 transition-all group-aria-expanded:scale-100 group-aria-expanded:opacity-100"
						fill="none"
						focusable="false"
						stroke="currentColor"
						stroke-width="1.5"
						viewBox="0 0 24 24"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</button>
			</mobile-button>
		</div>
	</div>
</header>

<script>
	import { toggleClass } from "@/utils/domElement";

	class MobileNavBtn extends HTMLElement {
		#menuOpen: boolean = false;

		connectedCallback() {
			const headerEl = document.getElementById("main-header");
			const mobileButtonEl = this.querySelector<HTMLButtonElement>("button");

			mobileButtonEl?.addEventListener("click", () => {
				if (headerEl) toggleClass(headerEl, "menu-open");
				this.#menuOpen = !this.#menuOpen;
				mobileButtonEl.setAttribute("aria-expanded", this.#menuOpen.toString());
			});
		}
	}

	customElements.define("mobile-button", MobileNavBtn);
</script>
