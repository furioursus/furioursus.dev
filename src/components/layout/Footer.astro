---
import { menuLinks, siteConfig } from "@/site.config";

const year = new Date().getFullYear();
---

<footer class="text-muted mt-auto flex w-full flex-col items-center justify-center gap-y-2 pt-20 pb-4 text-center align-top font-semibold sm:flex-row sm:justify-between sm:text-xs">
	<div class="me-0 flex gap-2 sm:me-4">
		<div>&copy; {siteConfig.author}</div>
		{year}.
	</div>
	<nav
		aria-label="Footer"
		class="sm:divide-muted flex flex-wrap justify-center gap-x-2 sm:gap-x-0 sm:divide-x"
	>
		{
			// Mirrors the header's row exactly, with one difference: "Home" is kept as a text link
			// here, where the header drops it because its logo already links home. Nested `children`
			// are deliberately not flattened in — see docs/navigation.md.
			menuLinks.map((link) => (
				<a class="hover:text-global-text px-4 py-2 hover:underline sm:py-0" href={link.path}>
					{link.title}
				</a>
			))
		}
	</nav>
</footer>
