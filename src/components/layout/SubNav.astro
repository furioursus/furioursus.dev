---
// Section subnavigation for pages nested under a `menuLinks` entry with `children` — see
// docs/navigation.md. Derives its own section from the current URL rather than taking props, so a
// page only has to drop `<SubNav />` in and nothing can pass the wrong section.
import { menuLinks } from "@/site.config";

/** Trailing-slash-insensitive so `/about/mtg` and `/about/mtg/` both resolve, and so the
	`startsWith` below can't match a sibling that merely shares a prefix (`/aboutish/`). */
const withSlash = (path: string) => (path.endsWith("/") ? path : `${path}/`);

const current = withSlash(Astro.url.pathname);
const section = menuLinks.find(
	(link) => link.children?.length && current.startsWith(withSlash(link.path)),
);
const links = section ? [section, ...(section.children ?? [])] : [];
---

{section && (
	<nav aria-label={`${section.title} section`} class="subnav mb-10 -ms-4">
		{/* FOOTGUN: divide-muted is required — divide-* ships no color and border-color falls
				back to currentColor, so each separator would take its preceding link's own state
				color. Same trap as the main nav; see docs/navigation.md. */}
		<ul class="divide-muted flex flex-wrap sm:divide-x" role="list">
			{links.map((link) => (
				<li>
					<a
						aria-current={current === withSlash(link.path) ? "page" : false}
						class="text-accent hover:text-nav-hover active:text-nav-hover aria-[current=page]:text-accent-2 relative inline-block px-4 py-1 font-semibold underline-offset-2 hover:underline"
						href={link.path}
					>
						{link.title}
					</a>
				</li>
			))}
		</ul>
	</nav>
)}

<style>
	/* FOOTGUN: `view-transition-name` values are global even from an Astro-scoped <style> — scoping
		rewrites the selector, not the name. Both names here must stay unique across the document.
		See docs/view-transitions.md. */
	.subnav {
		view-transition-name: section-subnav;
	}

	/* The active marker is a real box rather than `text-decoration`, because only a box can carry a
		`view-transition-name` and slide between tabs. Exactly one link per page is `aria-current`,
		so the name stays unique and the browser morphs the bar from the old position to the new.
		Its ::view-transition-* rules live in styles/components/view-transitions.css — Astro rewrites
		selectors in this scoped block, and those pseudos are children of the document root, not of
		anything this component owns. */
	.subnav a[aria-current="page"]::after {
		background: var(--color-accent);
		block-size: 2px;
		content: "";
		inset-block-end: 0;
		inset-inline: 1rem;
		position: absolute;
		view-transition-name: subnav-indicator;
	}
</style>
