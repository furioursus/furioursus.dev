---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Explicit, customizable counterpart to the automatic satteriLightboxImagesPlugin
// markdown transform (src/plugins/satteri.ts) — import and use this directly in
// .astro files or .mdx posts when a specific image needs a crop/size the default
// doesn't give you. Renders the same markup/classes, so it's driven by the same
// globally-registered <lightbox-image> behavior (see Lightbox.astro).
interface Props {
	src: ImageMetadata;
	alt: string;
	/** Max height of the inline thumbnail. Any CSS length. @default "24rem" */
	thumbHeight?: string;
	/** Thumbnail width — pair with `fit="cover"` for a true crop instead of a shrink. */
	thumbWidth?: string;
	/** How the thumbnail fits its box. @default "contain" (shrinks, keeps the full photo) */
	fit?: "contain" | "cover";
	/** Force a crop shape when `fit="cover"`, e.g. "1/1", "4/3". */
	aspectRatio?: string;
	/** `true` shows `alt` as a caption below the image; a string shows that
	 * instead; omitted/false/undefined shows no caption. Shown under both the
	 * thumbnail and the enlarged dialog view. */
	caption?: string | boolean | undefined;
	/** Intrinsic display width/height for the generated responsive srcset —
	 * pass both to get an appropriately-sized set of images (via
	 * layout="constrained") instead of Astro serving the source's full
	 * resolution just to shrink it with CSS. Omit both to let astro:assets
	 * infer natural size from the source file, as before. Passing both also
	 * makes the dialog render its own separate, full-resolution `<Image>`
	 * instead of reusing the (deliberately smaller) thumbnail — see
	 * `needsSeparateDialogImage` below. */
	width?: number;
	height?: number;
	/** Overrides astro:assets' auto-computed `sizes` for the thumbnail's srcset, which
	 * (given `layout="constrained"`) defaults to `(min-width: {width}px) {width}px, 100vw` —
	 * correct only when the thumbnail actually renders at `width` on wide viewports. Pass this
	 * whenever the real display size is smaller/responsive (e.g. a grid cell narrower than
	 * `width`), so the browser fetches a candidate sized for how the image actually lays out
	 * instead of the widest one in the generated set. No effect without `width`/`height`. */
	sizes?: string;
	/** Forwarded to astro:assets Image — set for an above-the-fold image
	 * (e.g. a post's cover image) so it loads eagerly instead of lazily.
	 * @default false */
	priority?: boolean;
	class?: string;
}

const {
	src,
	alt,
	thumbHeight,
	thumbWidth,
	fit,
	aspectRatio,
	caption,
	width,
	height,
	sizes,
	priority,
	class: className,
} = Astro.props;

const captionText = caption === true ? alt : caption || undefined;

// Explicit width/height doesn't just *style* a smaller thumbnail — astro:assets
// actually generates a real file at those pixel dimensions (verified: the
// output .webp is a real WxH pixel file, not the source's natural size),
// physically cropped too when the requested ratio doesn't match the source's
// own. The trigger and dialog normally share one <img>, moved back and forth
// by Lightbox.astro — but there's no way to "un-shrink" (or "un-crop") a file
// that was never generated at full size in the first place. So whenever a
// caller passes explicit dimensions, the dialog gets its own separate <Image>
// instead, uncapped by the requested display size (see Lightbox.astro: it
// leaves a dialog-with-its-own-image alone rather than trying to move the
// trigger's smaller one into it).
const needsSeparateDialogImage = width !== undefined && height !== undefined;

// Only set the custom properties a caller actually overrode — everything else
// falls back to the defaults in src/styles/components/lightbox.css, which is
// what the automatic transform's markup uses too.
const style = Object.fromEntries(
	Object.entries({
		"--lightbox-thumb-max-h": thumbHeight,
		"--lightbox-thumb-width": thumbWidth,
		"--lightbox-thumb-fit": fit,
		"--lightbox-thumb-aspect": aspectRatio,
	}).filter(([, value]) => value !== undefined),
);
---

<lightbox-image class:list={["not-prose", "lightbox", className]} style={style}>
	<button type="button" class="lightbox-trigger" aria-haspopup="dialog">
		{
			width && height ? (
				<Image
					src={src}
					alt={alt}
					layout="constrained"
					width={width}
					height={height}
					sizes={sizes}
					priority={priority ?? false}
				/>
			) : (
				<Image src={src} alt={alt} priority={priority ?? false} />
			)
		}
	</button>
	{captionText && <p class="lightbox-caption">{captionText}</p>}
	<dialog class="lightbox-dialog">
		<button type="button" class="lightbox-icon-button lightbox-close" aria-label="Close image"></button>
		<button
			type="button"
			class="lightbox-icon-button lightbox-nav-prev"
			aria-label="Previous image"
			hidden
		></button>
		<button
			type="button"
			class="lightbox-icon-button lightbox-nav-next"
			aria-label="Next image"
			hidden
		></button>
		{needsSeparateDialogImage && <Image src={src} alt={alt} width={Math.min(src.width, 1600)} />}
		{captionText && <p class="lightbox-caption">{captionText}</p>}
		{
			/* For a caller that needs richer, dialog-only caption content (a link, multiple
			pieces of styled text) that the plain-string `caption` prop above can't express —
			renders nothing when unfilled, so every existing caller is unaffected. See
			RecordCard.astro for the one current use: cover art's artist/title/format info,
			hidden from the card on desktop and shown here instead (docs/discogs.md). */
		}
		<slot name="dialog-caption" />
	</dialog>
</lightbox-image>
