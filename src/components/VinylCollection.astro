---
// src/components/VinylCollection.astro
// The /music/ page's vinyl collection — a searchable, filterable grid over a Discogs collection.
// Defines the <record-collection> custom element (colocated with its markup, following the
// ThemeToggle.astro pattern — see docs/README.md's conventions section) that drives search/
// filter/sort entirely client-side, no re-fetch. See docs/discogs.md for the wider feature.
import type { CollectionSummary, DiscogsRelease } from "astro-discogs-collection/collection";
import RecordCard from "@/components/RecordCard.astro";

interface Props {
	formats: string[];
	/** Already sorted (see `queryCollection()` in music.astro) — this component renders order as-is. */
	releases: DiscogsRelease[];
	stats: CollectionSummary;
}

const { formats, releases, stats } = Astro.props;

// Cover size toggle — grid-only (see .size-toggle's `sm`-and-up display below): below that
// breakpoint the grid isn't a grid at all, it's RecordCard's own single-column row layout at a
// fixed thumbnail size (see docs/discogs.md), so a size control would have nothing to do there.
const COVER_SIZES = [
	{ value: "10rem", label: "Small" },
	{ value: "13rem", label: "Medium" },
	{ value: "18rem", label: "Large" },
] as const;
const DEFAULT_COVER_SIZE = COVER_SIZES[1].value;
---

<record-collection>
	<p class="text-muted mb-6 text-sm">
		<span data-count>{stats.totalRecords}</span> of {stats.totalRecords} records &middot; {
			stats.uniqueArtists
		}
		artists
	</p>

	<p class="empty" data-empty hidden>No records match your filters.</p>

	<div class="breakout-container">
		<div class="mx-auto max-w-7xl px-4 sm:px-8">
			<div class="controls">
				<label class="control" for="vinyl-search">
					<span class="sr-only">Search by artist or title</span>
					<input
						autocomplete="off"
						data-search-input
						id="vinyl-search"
						placeholder="Search artist or title…"
						type="search"
					/>
				</label>

				<label class="control" for="vinyl-genre">
					<span class="sr-only">Filter by genre</span>
					<select data-genre-select id="vinyl-genre">
						<option value="">All genres</option>
						{stats.genres.map((genre) => <option value={genre}>{genre}</option>)}
					</select>
				</label>

				<label class="control" for="vinyl-format">
					<span class="sr-only">Filter by format</span>
					<select data-format-select id="vinyl-format">
						<option value="">All formats</option>
						{formats.map((format) => <option value={format}>{format}</option>)}
					</select>
				</label>

				<label class="control" for="vinyl-sort">
					<span class="sr-only">Sort by</span>
					<select data-sort-select id="vinyl-sort">
						<option value="artist">Artist (A–Z)</option>
						<option value="title">Title (A–Z)</option>
						<option value="year-desc">Year (newest)</option>
						<option value="year-asc">Year (oldest)</option>
						<option value="added-desc">Recently added</option>
					</select>
				</label>

				<button data-reset-button type="button"> Reset </button>

				<fieldset class="size-toggle" data-size-toggle>
					<legend class="sr-only">Cover size</legend>
					{
						COVER_SIZES.map(({ value, label }) => (
							<label class="size-option">
								<input
									checked={value === DEFAULT_COVER_SIZE}
									name="cover-size"
									type="radio"
									value={value}
								/>
								{label}
							</label>
						))
					}
				</fieldset>
			</div>
			<ul class="grid" data-lightbox-gallery role="list">
				{
					releases.map((release) => (
						<li
							class="record-item"
							data-artist={release.artist.toLowerCase()}
							data-date-added={release.dateAdded ?? ""}
							data-formats={release.formats.join("|").toLowerCase()}
							data-genres={release.genres.join("|").toLowerCase()}
							data-search={`${release.artist} ${release.title} ${release.labels.join(" ")}`.toLowerCase()}
							data-title={release.title.toLowerCase()}
							data-year={release.year}
						>
							<RecordCard release={release} titleLevel={3} />
						</li>
					))
				}
			</ul>
		</div>

		<style>
			.controls {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-bottom: 1.5rem;
			}

			.control {
				display: block;
			}

			input[type="search"],
			select,
			button[data-reset-button] {
				font: inherit;
				font-size: 0.875rem;
				color: var(--color-global-text);
				background: var(--color-global-bg);
				border: 1px dashed var(--color-muted);
				border-radius: 2px;
				padding: 0.4rem 0.6rem;
			}

			input[type="search"] {
				min-width: 14rem;
			}

			button[data-reset-button] {
				cursor: pointer;
				border-style: solid;
			}

			button[data-reset-button]:hover {
				color: var(--color-accent);
				border-color: var(--color-accent);
			}

			input[type="search"]:focus-visible,
			select:focus-visible,
			button[data-reset-button]:focus-visible {
				outline: 2px solid var(--color-accent);
				outline-offset: 1px;
			}

			/* A radio group styled as a segmented button toggle, same dashed-border look as the
			   button/select controls above. Hidden below sm — see the COVER_SIZES comment in the
			   frontmatter for why there's nothing for it to control at that breakpoint. */
			.size-toggle {
				display: none;
				gap: 0.5rem;
				margin: 0;
				padding: 0;
				border: 0;
			}

			@media (min-width: 640px) {
				.size-toggle {
					display: flex;
				}
			}

			.size-option {
				font-size: 0.875rem;
				color: var(--color-global-text);
				background: var(--color-global-bg);
				border: 1px dashed var(--color-muted);
				border-radius: 2px;
				padding: 0.4rem 0.6rem;
				cursor: pointer;
			}

			.size-option:hover {
				color: var(--color-accent);
				border-color: var(--color-accent);
			}

			.size-option:has(input:checked) {
				color: var(--color-accent);
				border-style: solid;
				border-color: var(--color-accent);
			}

			.size-option:has(input:focus-visible) {
				outline: 2px solid var(--color-accent);
				outline-offset: 1px;
			}

			/* Visually hidden, not display:none — a hidden radio input still needs to be
			   focusable/checkable for keyboard and assistive tech; the label above is what carries
			   the toggle's visible button look. */
			.size-option input {
				position: absolute;
				width: 1px;
				height: 1px;
				overflow: hidden;
				clip-path: inset(50%);
			}

			.empty {
				opacity: 0.7;
			}

			/* Mobile-first: a single-column list of rows (see RecordCard.astro). */
			.grid {
				display: block;
				padding: 0;
				margin: 0;
				list-style: none;
				--cover-size: 13rem;
			}

			@media (min-width: 640px) {
				.grid {
					display: grid;
					grid-template-columns: repeat(auto-fill, minmax(var(--cover-size), 1fr));
					gap: 1rem;
				}
			}

			.record-item[hidden] {
				display: none;
			}
		</style>

		<script>
			type SortKey = "artist" | "title" | "year-desc" | "year-asc" | "added-desc";

			const sortComparators: Record<SortKey, (a: HTMLElement, b: HTMLElement) => number> = {
				artist: (a, b) => (a.dataset.artist ?? "").localeCompare(b.dataset.artist ?? ""),
				title: (a, b) => (a.dataset.title ?? "").localeCompare(b.dataset.title ?? ""),
				"year-desc": (a, b) => Number(b.dataset.year ?? 0) - Number(a.dataset.year ?? 0),
				"year-asc": (a, b) => Number(a.dataset.year ?? 0) - Number(b.dataset.year ?? 0),
				"added-desc": (a, b) =>
					(b.dataset.dateAdded ?? "").localeCompare(a.dataset.dateAdded ?? ""),
			};

			// Keep in sync with COVER_SIZES in the frontmatter above — that's what renders the
			// radios in the first place, this just re-validates anything read back out of
			// localStorage (a hand-edited or stale value shouldn't get fed straight into
			// setProperty unchecked).
			const COVER_SIZE_STORAGE_KEY = "vinyl-cover-size";
			const COVER_SIZES = ["10rem", "13rem", "18rem"];

			class RecordCollection extends HTMLElement {
				#items: HTMLLIElement[] = [];
				#list: HTMLUListElement | null = null;

				connectedCallback() {
					this.#list = this.querySelector<HTMLUListElement>(".grid");
					this.#items = Array.from(this.querySelectorAll<HTMLLIElement>(".record-item"));

					const searchInput = this.querySelector<HTMLInputElement>("[data-search-input]");
					const genreSelect = this.querySelector<HTMLSelectElement>("[data-genre-select]");
					const formatSelect = this.querySelector<HTMLSelectElement>("[data-format-select]");
					const sortSelect = this.querySelector<HTMLSelectElement>("[data-sort-select]");
					const resetButton = this.querySelector<HTMLButtonElement>("[data-reset-button]");
					const sizeInputs = Array.from(
						this.querySelectorAll<HTMLInputElement>('[data-size-toggle] input[name="cover-size"]'),
					);

					searchInput?.addEventListener("input", () => this.#applyFilters());
					genreSelect?.addEventListener("change", () => this.#applyFilters());
					formatSelect?.addEventListener("change", () => this.#applyFilters());
					sortSelect?.addEventListener("change", () =>
						this.#applySort(sortSelect.value as SortKey),
					);

					resetButton?.addEventListener("click", () => {
						if (searchInput) searchInput.value = "";
						if (genreSelect) genreSelect.value = "";
						if (formatSelect) formatSelect.value = "";
						this.#applyFilters();
					});

					for (const input of sizeInputs) {
						input.addEventListener("change", () => this.#setCoverSize(input.value, true));
					}

					// Restore a returning visitor's choice. Server-rendered markup always checks
					// "Medium" (see DEFAULT_COVER_SIZE) — a stored non-default size means one brief
					// reflow to the right column width on load, same trade-off the rest of this
					// component makes for search/filter/sort state (all client-only, nothing here
					// blocks first paint to avoid it).
					const stored = this.#readStoredCoverSize();
					if (stored) {
						this.#setCoverSize(stored, false);
						const matchingInput = sizeInputs.find((input) => input.value === stored);
						if (matchingInput) matchingInput.checked = true;
					}
				}

				#setCoverSize(size: string, persist: boolean) {
					if (!COVER_SIZES.includes(size)) return;
					this.#list?.style.setProperty("--cover-size", size);
					if (!persist) return;
					try {
						localStorage.setItem(COVER_SIZE_STORAGE_KEY, size);
					} catch {
						// Private browsing / storage disabled — the toggle still works for this
						// pageview, it just won't stick around for the next one.
					}
				}

				#readStoredCoverSize(): string | null {
					try {
						return localStorage.getItem(COVER_SIZE_STORAGE_KEY);
					} catch {
						return null;
					}
				}

				#applyFilters() {
					const search =
						this.querySelector<HTMLInputElement>("[data-search-input]")
							?.value.trim()
							.toLowerCase() ?? "";
					const genre =
						this.querySelector<HTMLSelectElement>("[data-genre-select]")?.value.toLowerCase() ?? "";
					const format =
						this.querySelector<HTMLSelectElement>("[data-format-select]")?.value.toLowerCase() ??
						"";

					let visible = 0;
					for (const item of this.#items) {
						const matchesSearch = !search || (item.dataset.search ?? "").includes(search);
						const matchesGenre = !genre || (item.dataset.genres ?? "").split("|").includes(genre);
						const matchesFormat =
							!format || (item.dataset.formats ?? "").split("|").includes(format);
						const show = matchesSearch && matchesGenre && matchesFormat;
						item.hidden = !show;
						if (show) visible++;
					}

					const countEl = this.querySelector("[data-count]");
					if (countEl) countEl.textContent = String(visible);

					const emptyEl = this.querySelector<HTMLElement>("[data-empty]");
					if (emptyEl) emptyEl.hidden = visible !== 0;
				}

				#applySort(key: SortKey) {
					const comparator = sortComparators[key] ?? sortComparators.artist;
					const sorted = [...this.#items].sort(comparator);
					for (const item of sorted) this.#list?.append(item);
					this.#items = sorted;
				}
			}

			customElements.define("record-collection", RecordCollection);
		</script>
	</div>
</record-collection>
