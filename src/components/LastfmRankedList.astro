---
// src/components/LastfmRankedList.astro
// One ranked top-N list (artists, albums, or tracks) for a single Last.fm time range. Rendered
// three times per period inside music.astro's period panels — see docs/lastfm.md.
import type { LastfmTopItem } from "@/utils/lastfm";

interface Props {
	items: LastfmTopItem[];
	/** Show each item's artist as a subtitle — on for albums/tracks, off for the artist list itself. */
	showArtist?: boolean;
	title: string;
}

const { items, showArtist = false, title } = Astro.props;
---

<div class="ranked-list">
	<h3>{title}</h3>
	{
		items.length === 0 ? (
			<p class="empty">Nothing scrobbled in this range yet.</p>
		) : (
			<ol>
				{items.map((item, index) => (
					<li>
						<span class="rank" aria-hidden="true">
							{index + 1}
						</span>
						<a class="meta" href={item.url} rel="noopener" target="_blank">
							<span class="name">{item.name}</span>
							{showArtist && item.artist && <span class="artist">{item.artist}</span>}
						</a>
						<span class="playcount">{item.playcount.toLocaleString()}</span>
					</li>
				))}
			</ol>
		)
	}
</div>

<style>
	.ranked-list {
		/* Grid items default to `min-width: auto` (their max-content size) — for a row with
		   `white-space: nowrap` text, that's as wide as the longest title/artist string, which
		   forces its `.stats-grid` column wider than its `1fr` share and pushes the other
		   columns (and the page) uneven/overflowing. Pinning this to 0 is what actually lets
		   the three columns land equal-width and lets .name/.artist's own overflow/ellipsis
		   rules do their job, instead of the column just growing to avoid ever needing them. */
		min-width: 0;
	}

	.ranked-list h3 {
		margin: 0 0 0.5rem;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		opacity: 0.7;
	}

	.empty {
		font-size: 0.8rem;
		opacity: 0.6;
	}

	ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.3rem 0;
		border-bottom: 1px solid var(--color-muted);
	}

	li:last-child {
		border-bottom: none;
	}

	.rank {
		flex: none;
		width: 1.25rem;
		font-size: 0.75rem;
		text-align: right;
		opacity: 0.5;
	}

	.meta {
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-width: 0;
		/* Reserves space for two lines (.name + .artist) even when `showArtist` is off — the Top
		   Artists list only ever renders .name, one line, but its rows still need to match the
		   height album/track rows get from actually having both lines. Keep in sync with
		   .name/.artist's font-size/line-height below if either changes. */
		min-height: calc(0.85rem * 1.3 + 0.75rem * 1.3);
		text-decoration: none;
		color: inherit;
		flex: 1;
	}

	.meta:hover .name {
		color: var(--color-accent);
	}

	.name {
		font-size: 0.85rem;
		line-height: 1.3;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.artist {
		font-size: 0.75rem;
		line-height: 1.3;
		opacity: 0.6;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.playcount {
		flex: none;
		font-size: 0.75rem;
		opacity: 0.6;
	}
</style>
