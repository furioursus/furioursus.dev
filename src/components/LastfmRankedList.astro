---
// src/components/LastfmRankedList.astro
// One ranked top-N list (artists, albums, or tracks) for a single Last.fm time range. Rendered
// three times per period inside music.astro's period panels — see docs/lastfm.md.
import type { LastfmTopItem } from "@/utils/lastfm";

interface Props {
	items: LastfmTopItem[];
	/** Show each item's artist as a subtitle — on for albums/tracks, off for the artist list itself. */
	showArtist?: boolean;
	title: string;
}

const { items, showArtist = false, title } = Astro.props;
---

<div class="min-w-0">
	{
		// Grid items default to `min-width: auto` (their max-content size) — for a row with
		// `whitespace-nowrap` text, that's as wide as the longest title/artist string, which
		// forces this list's column, in LastfmListeningStats.astro's sm:grid-cols-3 grid, wider
		// than its `1fr` share and pushes the other columns (and the page) uneven/overflowing.
		// `min-w-0` above is what actually lets the three columns land equal-width and lets the
		// name/artist spans' own overflow/ellipsis rules do their job, instead of the column
		// just growing to avoid ever needing them.
	}
	<h3 class="mt-0 mb-2 text-2xs uppercase tracking-label opacity-70">{title}</h3>
	{
		items.length === 0 ? (
			<p class="text-2xs opacity-60">Nothing scrobbled in this range yet.</p>
		) : (
			<ol class="m-0 list-none p-0">
				{items.map((item, index) => (
					<li class="flex items-center gap-2 border-b border-muted py-1.6 last:border-b-0">
						<span class="w-5 flex-none text-right text-xs opacity-50" aria-hidden="true">
							{index + 1}
						</span>
						<a
							class="group flex min-h-[calc(0.85rem*1.3_+_0.75rem*1.3)] min-w-0 flex-1 flex-col justify-center text-inherit no-underline"
							href={item.url}
							rel="noopener"
							target="_blank"
						>
							{
								// The <a>'s min-h reserves space for two lines (name + artist) even when
								// `showArtist` is off — the Top Artists list only ever renders the name, one
								// line, but its rows still need to match the height album/track rows get from
								// actually having both lines. Keep in sync with the name/artist spans' text
								// size/leading below if either changes.
							}
							<span
								class="overflow-hidden text-[0.85rem] leading-compact text-ellipsis whitespace-nowrap group-hover:text-accent"
							>
								{item.name}
							</span>
							{showArtist && item.artist && (
								<span class="overflow-hidden text-xs leading-compact text-ellipsis whitespace-nowrap opacity-60">
									{item.artist}
								</span>
							)}
						</a>
						<span class="flex-none text-xs opacity-60">{item.playcount.toLocaleString()}</span>
					</li>
				))}
			</ol>
		)
	}
</div>
