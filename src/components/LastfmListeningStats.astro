---
// The /about/music/ page's Last.fm top artists/albums/tracks, tabbed by time range. Panels and lists render
// here on the server; only ListeningStatsTabs.vue (the shared PeriodTabs) hydrates. See docs/lastfm.md.
import { RankedList } from "@furioursus/ui/vue";
import ListeningStatsTabs from "@/components/ListeningStatsTabs.vue";
import {
	LASTFM_PERIODS,
	type LastfmPeriod,
	type LastfmTopItem,
	type MusicStatsPeriod,
} from "@/utils/lastfm";

interface Props {
	periods: Partial<Record<LastfmPeriod, MusicStatsPeriod>>;
}

const { periods } = Astro.props;
const DEFAULT_PERIOD = LASTFM_PERIODS[0].value;
const ID = "listening-stats";
const EMPTY = "Nothing scrobbled in this range yet.";

const rows = (items: LastfmTopItem[] = [], withArtist = false) =>
	items.map((item) => ({
		name: item.name,
		subtitle: withArtist ? item.artist : undefined,
		count: item.playcount,
		url: item.url,
	}));
---

<div>
	<h2 class="mt-10 mb-3 text-lg font-semibold">Listening stats</h2>
	<ListeningStatsTabs client:visible class="mb-4" idPrefix={ID} options={[...LASTFM_PERIODS]} />

	{LASTFM_PERIODS.map(({ value }) => {
		const period = periods[value];
		return (
			<div
				aria-labelledby={`${ID}-tab-${value}`}
				hidden={value !== DEFAULT_PERIOD}
				id={`${ID}-panel-${value}`}
				role="tabpanel"
			>
				<p class="text-muted mb-3 text-sm">
					{(period?.totalArtists ?? 0).toLocaleString()} artists &middot;{" "}
					{(period?.totalAlbums ?? 0).toLocaleString()} albums &middot;{" "}
					{(period?.totalTracks ?? 0).toLocaleString()} tracks
				</p>
				<div class="breakout-container">
					<div class="mx-auto max-w-7xl px-4 sm:px-8">
						<div class="mb-8 grid gap-6 sm:grid-cols-3">
							<RankedList emptyText={EMPTY} items={rows(period?.artists)} newTab title="Top Artists" />
							<RankedList emptyText={EMPTY} items={rows(period?.albums, true)} newTab title="Top Albums" />
							<RankedList emptyText={EMPTY} items={rows(period?.tracks, true)} newTab title="Top Tracks" />
						</div>
					</div>
				</div>
			</div>
		);
	})}
</div>
