---
// src/components/RecordCard.astro
import type { DiscogsRelease } from "astro-discogs-collection/collection";
import { getLocalCoverImage } from "astro-discogs-collection/images";
import LightboxImage from "@/components/LightboxImage.astro";
import coverAltData from "@/data/discogs-cover-alt.json";

interface Props {
	release: DiscogsRelease;
	/**
	 * Heading level for the title, or `false` to render it as a plain `<p>` instead of a
	 * heading. Defaults to `2` — callers stacking multiple cards under their own heading (e.g.
	 * a future non-list layout) can pass a deeper level, or `false` where a heading would be
	 * redundant/invalid in context.
	 */
	titleLevel?: 1 | 2 | 3 | 4 | 5 | 6 | false;
}

const { release, titleLevel = 2 } = Astro.props;
const localImage = getLocalCoverImage(release.id);
const TitleTag = titleLevel === false ? "p" : (`h${titleLevel}` as const);
// Generated alt describes the cover's actual imagery (see scripts/generate-cover-alt.mjs /
// docs/discogs.md) — falls back to plain metadata for any release that hasn't been
// backfilled yet, so a fresh checkout with an empty cache still gets *something* accessible.
const generatedAlt = (coverAltData as Record<string, { alt: string }>)[String(release.id)]?.alt;
const coverAlt = generatedAlt ?? `${release.artist} – ${release.title}`;
const metaText = [release.year || null, release.formats.join(", ") || null]
	.filter(Boolean)
	.join(" ");
// From sm up, `.info` below is hidden in favor of this same artist/title/meta info shown inside
// the lightbox dialog instead (see the `dialog-caption` slot below and .dialog-info's styles) —
// but only when there's actually a cover/dialog to show it in. The no-cover placeholder path has
// no lightbox at all, so `.info` stays the only place that information ever appears.
const hasLightbox = Boolean(localImage) || Boolean(release.coverImageUrl);
---

<div class="record">
	{
		// The cover art is its own click target (opens the enlarged view) rather than living
		// inside the link below — a <button>, which the lightbox trigger renders as, can't
		// legally nest inside an <a>. So the card has two separate interactive pieces: the
		// image opens the lightbox, the text links out to the Discogs release page.
		localImage ? (
			// width/height downsize the on-page thumbnail (astro:assets really does generate a
			// smaller physical file, not just a CSS-cropped view) — passing them also makes
			// LightboxImage render the dialog's own separate, full-resolution <Image> instead of
			// reusing that thumbnail, so the enlarged view is the largest cover art we have, not
			// just the 500×500 crop. See LightboxImage.astro's `needsSeparateDialogImage`.
			// The thumbnail never actually renders wider than the grid's own "Large" cell size
			// (18rem/288px, see VinylCollection.astro's COVER_SIZES) or the mobile row's fixed
			// 3.5rem/56px (.record :global(.cover) above) — 500 was Discogs's own thumbnail
			// resolution, not a real display size, and was making Astro generate (and browsers
			// fetch) a candidate roughly 3x heavier than anything ever shown on-page.
			// width/height only set the *thumbnail's* resolution here; the dialog still gets
			// its own full-res Image regardless (see needsSeparateDialogImage above).
			<LightboxImage
				class="cover"
				src={localImage}
				alt={coverAlt}
				fit="cover"
				aspectRatio="1/1"
				thumbWidth="100%"
				thumbHeight="none"
				width={288}
				height={288}
				sizes="(min-width: 640px) 18rem, 3.5rem"
			>
				<a slot="dialog-caption" class="lightbox-caption dialog-info" href={release.releaseUrl} target="_blank" rel="noopener">
					<span class="dialog-artist">{release.artist}</span>
					<span class="dialog-title">{release.title}</span>
					{metaText && <span class="dialog-meta">{metaText}</span>}
				</a>
			</LightboxImage>
		) : release.coverImageUrl ? (
			// No local cache yet (e.g. before the first image-cache run) — coverImageUrl is
			// already Discogs's full-size art with no local resize applied, so a hand-rolled
			// lightbox around a plain <img> just needs to move that same already-loaded element
			// into the dialog on click; there's no larger version to separately fetch. This
			// mirrors the trigger/dialog/close structure LightboxImage.astro renders (see
			// docs/lightbox.md) without astro:assets, which can't optimize a remote URL here.
			<lightbox-image
				class="cover"
				style={{
					"--lightbox-thumb-width": "100%",
					"--lightbox-thumb-fit": "cover",
					"--lightbox-thumb-aspect": "1/1",
				}}
			>
				<button type="button" class="lightbox-trigger" aria-haspopup="dialog">
					<img src={release.coverImageUrl} alt={coverAlt} loading="lazy" width="500" height="500" />
				</button>
				<dialog class="lightbox-dialog">
					<button type="button" class="lightbox-icon-button lightbox-close" aria-label="Close image" />
					<button
						type="button"
						class="lightbox-icon-button lightbox-nav-prev"
						aria-label="Previous image"
						hidden
					/>
					<button
						type="button"
						class="lightbox-icon-button lightbox-nav-next"
						aria-label="Next image"
						hidden
					/>
					<a class="lightbox-caption dialog-info" href={release.releaseUrl} target="_blank" rel="noopener">
						<span class="dialog-artist">{release.artist}</span>
						<span class="dialog-title">{release.title}</span>
						{metaText && <span class="dialog-meta">{metaText}</span>}
					</a>
				</dialog>
			</lightbox-image>
		) : (
			<div class="placeholder">{release.title}</div>
		)
	}
	<a
		class:list={["info", { "info--has-lightbox": hasLightbox }]}
		href={release.releaseUrl}
		target="_blank"
		rel="noopener"
	>
		<p class="artist">{release.artist}</p>
		<TitleTag class="title">{release.title}</TitleTag>
		<p class="meta">{metaText}</p>
	</a>
</div>

<style>
	/* Mobile-first: a compact row — thumbnail left, text right. */
	.record {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.4rem 0;
		border-bottom: 1px solid var(--color-muted);
	}
	/* .cover is now the lightbox's own <lightbox-image> wrapper (either
	   LightboxImage.astro's, or the hand-rolled one for the remote-URL
	   fallback below) — it sizes/crops itself via the --lightbox-thumb-*
	   custom properties, so this just controls the wrapper's box size.
	   LightboxImage.astro renders that wrapper (and the <img> inside it)
	   itself, so neither ever picks up this file's own scope hash — every
	   selector reaching past `.record` needs :global(), or it silently
	   matches nothing (which is exactly what made mobile thumbnails balloon
	   to inconsistent sizes: this width rule wasn't applying at all). */
	.record :global(.cover),
	.record .placeholder {
		flex: none;
		width: 3.5rem;
	}
	.record :global(.cover img) {
		border-radius: 0.25rem;
	}
	.placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: 1;
		font-size: 0.6rem;
		text-align: center;
		padding: 0.25rem;
		background: var(--color-global-bg);
		border: 1px dashed var(--color-muted);
		border-radius: 0.25rem;
	}
	.info {
		display: block;
		min-width: 0;
		text-decoration: none;
		color: inherit;
	}
	.artist {
		font-size: 0.8rem;
		opacity: 0.7;
		margin: 0;
	}
	.title {
		margin: 0.1rem 0;
		font-weight: 600;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.meta {
		font-size: 0.8rem;
		opacity: 0.6;
		margin: 0;
	}

	/* The artist/title/meta shown inside the lightbox dialog in place of `.info`, from sm up (see
	   `hasLightbox` above) — `.lightbox-caption` (global, from lightbox.css) already supplies the
	   muted/centered/small-text look plus the width:0/min-width:100% fix a long title needs to
	   avoid dragging the dialog wider than the photo (see docs/lightbox.md's Captions section);
	   this just re-adds a link's affordance and makes the title itself stand out from the rest. */
	.dialog-info {
		display: block;
		text-decoration: none;
		color: inherit;
	}
	.dialog-info:hover .dialog-title {
		color: var(--color-accent);
	}
	.dialog-artist,
	.dialog-title,
	.dialog-meta {
		display: block;
	}
	.dialog-title {
		margin: 0.1rem 0;
		font-weight: 600;
		color: var(--color-global-text);
	}

	/* From sm up: back to the card grid — cover on top, text below. */
	@media (min-width: 640px) {
		.record {
			display: block;
			padding: 0;
			border-bottom: none;
		}
		.record :global(.cover),
		.record .placeholder {
			width: 100%;
		}
		.info {
			margin-top: 0.5rem;
		}
		.info.info--has-lightbox {
			display: none;
		}
		.title {
			white-space: normal;
		}
	}
</style>
