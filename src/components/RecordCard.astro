---
// src/components/RecordCard.astro
import { Image } from "astro:assets";
import { getLocalCoverImage } from "astro-discogs-collection/images";
import type { DiscogsRelease } from "astro-discogs-collection/collection";

interface Props {
	release: DiscogsRelease;
	/**
	 * Heading level for the title, or `false` to render it as a plain `<p>` instead of a
	 * heading. Defaults to `2` — callers stacking multiple cards under their own heading (e.g.
	 * a future non-list layout) can pass a deeper level, or `false` where a heading would be
	 * redundant/invalid in context.
	 */
	titleLevel?: 1 | 2 | 3 | 4 | 5 | 6 | false;
}

const { release, titleLevel = 2 } = Astro.props;
const localImage = getLocalCoverImage(release.id);
const TitleTag = titleLevel === false ? "p" : (`h${titleLevel}` as const);
---

<a class="record" href={release.releaseUrl} target="_blank" rel="noopener">
	{
		// alt="": the card is a single link and the cover art is immediately followed by the
		// artist/title as visible text below, so a spoken alt would just repeat them. The
		// placeholder div is the one exception — it has no adjacent text, so it keeps its own
		// accessible text via its content instead.
		localImage ? (
			<Image class="cover" src={localImage} alt="" width={500} height={500} />
		) : release.coverImageUrl ? (
			<img
				class="cover"
				src={release.coverImageUrl}
				alt=""
				loading="lazy"
				width="500"
				height="500"
			/>
		) : (
			<div class="placeholder">{release.title}</div>
		)
	}
	<div class="info">
		<p class="artist">{release.artist}</p>
		<TitleTag class="title">{release.title}</TitleTag>
		<p class="meta">{release.year || ""} {release.formats.join(", ")}</p>
	</div>
</a>

<style>
	/* Mobile-first: a compact row — thumbnail left, text right. */
	.record {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		color: inherit;
		padding: 0.4rem 0;
		border-bottom: 1px solid var(--color-muted);
	}
	.record .cover,
	.record .placeholder {
		flex: none;
		width: 3.5rem;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 0.25rem;
	}
	.placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.6rem;
		text-align: center;
		padding: 0.25rem;
		background: var(--color-global-bg);
		border: 1px dashed var(--color-muted);
	}
	.info {
		min-width: 0;
	}
	.artist {
		font-size: 0.8rem;
		opacity: 0.7;
		margin: 0;
	}
	.title {
		margin: 0.1rem 0;
		font-weight: 600;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.meta {
		font-size: 0.8rem;
		opacity: 0.6;
		margin: 0;
	}

	/* From sm up: back to the card grid — cover on top, text below. */
	@media (min-width: 640px) {
		.record {
			display: block;
			padding: 0;
			border-bottom: none;
		}
		.record .cover,
		.record .placeholder {
			width: 100%;
		}
		.info {
			margin-top: 0.5rem;
		}
		.title {
			white-space: normal;
		}
	}
</style>
