---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import FormattedDate from "@/components/FormattedDate.astro";
import LightboxImage from "@/components/LightboxImage.astro";

interface Props {
	content: CollectionEntry<"blog">;
	readingTime: string;
}

const {
	content: { data },
	readingTime,
} = Astro.props;

// Default is `alt`, shown unless explicitly opted out — the opposite of the
// lightbox's opt-in captions (see LightboxImage.astro / satteri.ts), since
// alt text is already required on a cover image, so showing it costs nothing.
const rawCaption = data.coverImage?.caption;
const coverCaption =
	rawCaption === false || rawCaption === null || rawCaption === ""
		? undefined // explicit opt-out
		: rawCaption === true || rawCaption === undefined
			? data.coverImage?.alt // default
			: rawCaption; // explicit override
---

{data.coverImage && (
	<LightboxImage
		src={data.coverImage.src}
		alt={data.coverImage.alt}
		caption={coverCaption}
		fit="cover"
		aspectRatio="16/9"
		thumbWidth="100%"
		thumbHeight="none"
		width={948}
		height={533}
		priority
		class="mb-6 block md:-ms-25 md:-me-25"
	/>
)}
{data.draft ? <span class="text-base text-red-500">(Draft)</span> : null}
<h1 class="title">{data.title}</h1>
<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
	<p class="font-semibold">
		<FormattedDate date={data.publishDate} /> / {readingTime}
	</p>
	{data.updatedDate && (
		<span class="bg-quote/5 text-quote rounded-lg px-2 py-1">
			Updated:
			<FormattedDate class="ms-1" date={data.updatedDate} />
		</span>
	)}
</div>
{!!data.tags?.length && (
	<div class="mt-2">
		<Icon aria-hidden="true" class="text-muted inline-block h-6 w-6" focusable="false" name="tags" />
		{data.tags.map((tag, i) => (
			<>
				{/* prettier-ignore */}
				<span class="contents">
						<a class="site-link inline-block before:content-['#']" data-pagefind-filter={`tag:${tag}`} href={`/tags/${tag}/`}><span class="sr-only">View more blogs with the tag&nbsp;</span>{tag}
						</a>{i < data.tags.length - 1 && ", "}
					</span>
			</>
		))}
	</div>
)}
