---
import type { TocItem } from "@/utils/generateToc";

interface Props {
	heading: TocItem;
}

const {
	heading: { children, depth, slug, text },
} = Astro.props;
---

<li class={`${depth > 2 ? "ms-3" : ""}`}>
	<a
		class={`line-clamp-2 py-1 hover:text-accent underline-offset-2 hover:underline ${depth <= 2 ? "text-data font-medium" : "text-meta"}`}
		href={`#${slug}`}
	>
		<span aria-hidden="true" class="me-0.5">
			#
		</span>
		{text}
	</a>
	{!!children.length && (
		<ol>
			{children.map((subheading) => (
				<Astro.self heading={subheading} />
			))}
		</ol>
	)}
</li>
