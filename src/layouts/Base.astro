---
import { Font } from "astro:assets";
import BaseHead from "@/components/BaseHead.astro";
import Lightbox from "@/components/Lightbox.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import PropsForAuto from "@/components/PropsForAuto.astro";
import SkipLink from "@/components/SkipLink.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";
import "animate.css";

interface Props {
	meta: SiteMeta;
}

const {
	meta: { articleDate, description = siteConfig.description, ogImage, title },
} = Astro.props;
---

<html class="scroll-smooth" lang={siteConfig.lang}>
	<head>
		<BaseHead articleDate={articleDate} description={description} ogImage={ogImage} title={title} />
		{
			/* No `preload` here, deliberately — measured, not assumed. `<Font>` preloads every
			   variant of the family, so it would fetch the 126KB italic at high priority on every
			   page against ~2 italic elements of actual use, competing with the LCP image. And the
			   @font-face block is inlined in a <style> in this head rather than an external
			   sheet, so the font is already discovered on first parse; preload buys no meaningful
			   head start. Selective preload would need the family split in two, which would stop
			   <em> picking up the italic face automatically — worse. */
		}
		<Font cssVariable="--font-monolisa" />
		<ThemeProvider />
		<Lightbox />
	</head>
	<body class="text-global-text relative isolate overflow-x-clip">
		<PropsForAuto />
		{/* min-h-dvh, not min-h-screen (100vh) — on iOS Safari, `vh` resolves against the
			*large* viewport (toolbar fully collapsed), even while the toolbar is actually
			showing and eating into what's really visible. On a short page (few enough content
			that this min-height is the only reason it's even a full screen tall — Notes with
			only a couple of cards is exactly that case), that gap between the two viewport
			metrics shows up as real, scrollable phantom space below the actual content:
			`min-height` demands it exist, but body::after's fixed grain layer, sized against a
			*different* viewport metric than whatever produced that space, doesn't reliably
			follow into it — the flat, grain-less strip right where the real footer text sits,
			confirmed live on iPhone 17 sim/iOS 26.5. `dvh` is the *dynamic* viewport height
			unit, purpose-built for exactly this ambiguity: it tracks whatever's actually visible
			right now as the toolbar animates, so there's no longer a metric mismatch for a gap
			to open up in. */}
		<div class="mx-auto flex min-h-dvh max-w-3xl flex-col px-4 pt-8 font-mono text-sm font-normal antialiased sm:px-8 md:pt-16">
			<SkipLink />
			<Header />
			<main id="main">
				<slot />
			</main>
			<Footer />
		</div>
		<script is:inline type="speculationrules">
			{
				"prefetch": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "immediate"
					}
				],
				"prerender": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "moderate"
					}
				]
			}
		</script>
	</body>
</html>
