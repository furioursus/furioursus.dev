WEBMENTION_API_KEY=
WEBMENTION_URL=
WEBMENTION_PINGBACK=#optional
WEBMENTION_DOMAIN=#optional, set this if the domain verified with webmention.io differs from the `site` hostname (e.g. a www subdomain)
DISCOGS_USERNAME=furioursus
DISCOGS_TOKEN=your-personal-access-token
# Read-only Last.fm API key — create one at https://www.last.fm/api/account/create.
# Shipped to the browser on purpose (see the LASTFM_API_KEY comment in astro.config.ts).
LASTFM_API_KEY=your-lastfm-api-key
LASTFM_USERNAME=furioursus
